# Copy to .env.local and adjust for your environment.

# Chat upstream for same-origin /v1/chat/* proxy (server-side only).
CHAT_API_ORIGIN=https://intel-copilot-v1-git-71611170957.europe-west1.run.app

# Google One Tap / OAuth (public client id).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Sentry error monitoring (DSN is public by design).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: tag events (production / staging / preview).
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional: source map upload in CI (keep secret).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Auth, news, wallet, payments (/v1/me, /v1/news/*, …) — same-origin proxied.
# IRIS_API_ORIGIN=https://api.exur.ai

# Optional guest-session fallback when primary chat returns guest_unavailable.
# CHAT_API_GUEST_FALLBACK_ORIGIN=

# Public origin of this chat deployment (OAuth return URLs).
# NEXT_PUBLIC_APP_URL=https://chat.exur.ai

# Marketing SEO origin (metadataBase, sitemap, canonicals). Defaults to https://exur.ai.
# Do not point this at chat.exur.ai — the desk root is noindex.
# NEXT_PUBLIC_MARKETING_URL=https://exur.ai

# Optional analytics.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ID=

# Optional billing.
# NEXT_PUBLIC_BILLING_COUPON_CODE=
# NEXT_PUBLIC_STRIPE_PLUS_MONTHLY_URL=
# NEXT_PUBLIC_STRIPE_PLUS_YEARLY_URL=
# STRIPE_SECRET_KEY=
