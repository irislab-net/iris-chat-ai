# Copy to .env.local and adjust for your environment.

# Chat upstream for same-origin /v1/chat/* proxy (server-side only).
CHAT_API_ORIGIN=https://intel-copilot-v1-git-71611170957.europe-west1.run.app

# Auth, news, wallet, payments (/v1/me, /v1/news/*, …) — still same-origin proxied to api.exur.ai
# IRIS_API_ORIGIN=https://api.exur.ai

# Optional guest-session fallback when primary chat returns guest_unavailable (server proxy only)
# CHAT_API_GUEST_FALLBACK_ORIGIN=

# Google OAuth web client ID (Google Cloud Console) — enables One Tap on entry.
# Must match the OAuth client used by api.exur.ai and list this site's origin.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
