# Copy to .env.local and adjust for your environment.

# Chat co-pilot upstream (/v1/chat/message, /v1/chat/credits, …)
# Defaults to IRIS_API_ORIGIN when unset.
CHAT_API_ORIGIN=https://intel-copilot-v1-git-71611170957.europe-west1.run.app

# Auth, news, wallet, payments (/v1/me, /v1/news/*, …)
# IRIS_API_ORIGIN=https://api.irislab.info

# Optional guest-session fallback when primary chat returns guest_unavailable
# CHAT_API_GUEST_FALLBACK_ORIGIN=
