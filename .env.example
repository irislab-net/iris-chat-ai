# Copy to `.env.local` for local Next.js, or use Cloudflare `.dev.vars`
# (see `scripts/sync-dev-public-env.mjs`). Never commit real secrets.

# --- Public (safe for the browser) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
# Firebase web app (exur-main) — public client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# OAuth web client ID. Authorized JavaScript origins must include every
# origin you use (e.g. https://local.exur.ai:3000, https://chat.exur.ai).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Local only: set to 1 after adding https://local.exur.ai:3000 to that client.
# Off by default — FedCM otherwise logs NetworkError in the console.
NEXT_PUBLIC_ENABLE_GOOGLE_ONE_TAP_DEV=
NEXT_PUBLIC_APP_URL=https://chat.exur.ai
NEXT_PUBLIC_SITE_URL=https://exur.ai
NEXT_PUBLIC_MARKETING_URL=https://exur.ai
# Client Sentry is off in NODE_ENV=development even when DSN is set.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Plan display prices come from GET /v1/payments/plans (not env).
NEXT_PUBLIC_STRIPE_PLUS_MONTHLY_URL=
NEXT_PUBLIC_STRIPE_PLUS_ANNUAL_URL=
NEXT_PUBLIC_BILLING_COUPON_CODE=

# --- Server / Worker only (do not prefix with NEXT_PUBLIC_) ---
CHAT_API_ORIGIN=https://api.exur.ai
CHAT_API_GUEST_FALLBACK_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
# Server/edge Sentry is off in NODE_ENV=development even when DSN is set.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=production
