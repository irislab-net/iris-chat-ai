# Copy to .env.local and adjust for your environment.

# Direct browser chat API (no /v1/chat proxy). Also mirrored to NEXT_PUBLIC_CHAT_API_ORIGIN at build time.
CHAT_API_ORIGIN=https://intel-copilot-v1-git-71611170957.europe-west1.run.app
# NEXT_PUBLIC_CHAT_API_ORIGIN=https://intel-copilot-v1-git-71611170957.europe-west1.run.app

# Auth, news, wallet, payments (/v1/me, /v1/news/*, …) — still same-origin proxied to api.irislab.info
# IRIS_API_ORIGIN=https://api.irislab.info

# Optional guest-session fallback when primary chat returns guest_unavailable (server proxy only)
# CHAT_API_GUEST_FALLBACK_ORIGIN=
