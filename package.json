{
  "name": "exur",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:next": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "certs": "node scripts/generate-dev-certs.mjs",
    "dev": "node scripts/sync-dev-public-env.mjs && node scripts/generate-dev-certs.mjs && node scripts/print-lan-url.mjs && next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem --hostname 0.0.0.0 --port 3000",
    "dev:http": "node scripts/print-lan-url.mjs && next dev --hostname 0.0.0.0 --port 3000",
    "start": "next start --hostname localhost --port 3000",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true pnpm build:next",
    "benchmark:pages": "node scripts/benchmark-pages.mjs",
    "test:perf": "node scripts/benchmark-pages.mjs",
    "audit:deps": "pnpm audit --prod",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "narration:cues": "node scripts/narration-cues.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@sentry/nextjs": "11.0.0",
    "@wrksz/themes": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^4.3.0",
    "lucide-react": "1.47.0",
    "marked": "^18.0.11",
    "motion": "^13.1.1",
    "next": "16.3.6",
    "next-intl": "^4.14.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0",
    "react-resizable-panels": "^4.12.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.6",
    "@opennextjs/cloudflare": "^1.20.5",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.31.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.127.1"
  }
}
