{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// Must match the Cloudflare Workers Builds project / dashboard Worker name.
	"name": "iris-chat-ai",
	"account_id": "aed1f0c586e05927873b8b79db136dd4",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "iris-chat-ai"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "intel-front-opennext-cache"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Public Google OAuth web client ID (One Tap / GIS). Client secret lives on the API.
	"vars": {
		"NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-6B72W49JQE",
		"NEXT_PUBLIC_GTM_ID": "GTM-KMGLCNZD",
		"NEXT_PUBLIC_GOOGLE_CLIENT_ID": "50876205060-0j6l4c2b286q18e0vluvp7eadqcs15vq.apps.googleusercontent.com",
		"NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyDi4byocMKJ9oklAk4RdK_2CB6446NNy0w",
		"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "exur-main.firebaseapp.com",
		"NEXT_PUBLIC_FIREBASE_PROJECT_ID": "exur-main",
		"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "exur-main.firebasestorage.app",
		"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "604582580021",
		"NEXT_PUBLIC_FIREBASE_APP_ID": "1:604582580021:web:18e1fc01b3832baf36867c",
		"NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "G-RBYHCFCEE5",
		"NEXT_PUBLIC_FIREBASE_VAPID_KEY": "BK9TsESqOuYmjAmoEGFzpFw5FuagJyR9vzQ2X93YI-W3QWaUg9NFfUfjgdmkM4Q805OkiMR3a-BgECEALhOQRx4"
	},
	// Workers Logs + Traces (dashboard Observability). Redeploy required after change.
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
